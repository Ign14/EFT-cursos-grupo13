                "key": "Authorization",
                "value": "Bearer {{tokenInstructor}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseCursos}}/api/cursos/{{cursoId}}/material",
              "host": [
                "{{baseCursos}}"
              ],
              "path": [
                "api",
                "cursos",
                "{{cursoId}}",
                "material"
              ]
            }
          }
        },
        {
