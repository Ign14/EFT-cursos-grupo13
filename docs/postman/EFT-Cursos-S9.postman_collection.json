                "value": "Bearer {{tokenInstructor}}"
              }
            ],
            "url": {
              "raw": "{{baseCursos}}/api/cursos/{{cursoId}}",
              "host": [
                "{{baseCursos}}"
              ],
              "path": [
                "api",
                "cursos",
                "{{cursoId}}"
              ]
            }
          }
        },
        {
          "name": "4. Actualizar curso (PUT 200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInstructor}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Curso introductorio (actualizado)\",\n  \"cupos\": 40\n}"
