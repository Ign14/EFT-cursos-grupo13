{
  "info": {
    "name": "EFT Cursos S9 - Grupo 13",
    "description": "Pruebas del EFT: cursos-service (8081) y bff-service (8082). Roles ESTUDIANTE/INSTRUCTOR via Azure AD B2C. Cambia baseCursos/baseBff a la Invoke URL del API Gateway para probar en la nube.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseCursos",
      "value": "http://localhost:8081"
    },
    {
      "key": "baseBff",
      "value": "http://localhost:8082"
    },
    {
      "key": "tokenInstructor",
      "value": "PEGA_TOKEN_INSTRUCTOR"
    },
    {
      "key": "tokenEstudiante",
      "value": "PEGA_TOKEN_ESTUDIANTE"
    },
    {
      "key": "cursoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0. Sin token - Cursos (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseCursos}}/api/cursos",
          "host": [
            "{{baseCursos}}"
          ],
          "path": [
            "api",
            "cursos"
          ]
        }
      }
    },
    {
      "name": "=== CURSOS (INSTRUCTOR) ===",
      "item": [
        {
          "name": "1. Crear curso (POST 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInstructor}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"CN-101\",\n  \"nombre\": \"Cloud Native 101\",\n  \"descripcion\": \"Curso introductorio\",\n  \"cupos\": 30\n}"
            },
            "url": {
              "raw": "{{baseCursos}}/api/cursos",
              "host": [
                "{{baseCursos}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            }
          }
        },
        {
          "name": "2. Listar cursos (GET 200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInstructor}}"
              }
            ],
            "url": {
              "raw": "{{baseCursos}}/api/cursos",
              "host": [
                "{{baseCursos}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            }
          }
        },
        {
